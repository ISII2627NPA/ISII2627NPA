@page "/compras/listlibros"
@using AppForSEII.Web.API
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize]
@inject ILogger<ListLibrosParaComprar> logger
@inject IAppForSEIIAPIClient apiservice
@inject CompraStateContainer carritoState
@inject NavigationManager navigation

<!-- 1. CONTENEDOR PRINCIPAL -->
<div class="container">
    <h3 class="mb-4">Seleccionar Libros para Comprar</h3>

    <!-- 2. FILA DE FILTROS -->
    <div class="row mb-4">
        <div class="col-md-5">
            <input type="text" class="form-control" placeholder="Filtrar por género..." @bind="libroGenero" id="inputGenero" />
        </div>
        <div class="col-md-5">
            <input type="number" step="0.1" class="form-control" placeholder="Filtrar por precio máx (€)..." @bind="precioMaximo" id="precioMaximo" />
        </div>
        <div class="col-md-2">
            <button class="btn btn-secondary w-100" id="searchLibros" @onclick="SearchLibros">Buscar</button>
        </div>
    </div>

    <!-- Mensaje de aviso si ocurre algún error -->
    @if (!string.IsNullOrEmpty(messageError))
    {
        <div class="alert alert-warning" id="MessageError">@messageError</div>
    }

    <!-- 3. FILA PRINCIPAL: Dividida en 8 (Tabla) y 4 (Carrito) -->
    <div class="row">

        <!-- 3a. COLUMNA IZQUIERDA (Ocupa 8/12) - Lista de Libros -->
        <div class="col-md-8">
            <table class="table table-hover table-striped" id="TableOfLibros">
                <thead class="table-dark">
                    <tr>
                        <th>Título</th>
                        <th>Género</th>
                        <th>Editorial</th>
                        <th>Precio Compra</th>
                        <th>Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @if (libros == null)
                    {
                        <tr><td colspan="5">Cargando libros...</td></tr>
                    }
                    else if (!libros.Any())
                    {
                        <tr><td colspan="5">No se encontraron libros disponibles.</td></tr>
                    }
                    else
                    {
                        @foreach (var libro in libros)
                        {
                            <tr id="LibroData_@libro.Titulo">
                                <td>@libro.Titulo</td>
                                <td>@libro.Genero</td>
                                <td>@libro.Editorial</td>
                                <td>@libro.PrecioCompra.ToString("0.00") €</td>
                                <td>
                                    <button class="btn btn-sm btn-success" id="libroToBuy_@libro.Titulo" @onclick="() => AddLibro(libro)">Añadir</button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- 3b. COLUMNA DERECHA (Ocupa 4/12) - Carrito de Compra -->
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="card-title mb-0">Libros seleccionados (@carrito.CompraItems.Count)</h5>
                </div>

                <ul class="list-group list-group-flush">
                    @if (!carrito.CompraItems.Any())
                    {
                        <li class="list-group-item text-muted">Aún no has añadido ningún libro.</li>
                    }
                    else
                    {
                        @foreach (var item in carrito.CompraItems)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center" id="LibroSelected_@item.Titulo">
                                <span>@item.Titulo (@item.PrecioCompra.ToString("0.00") €)</span>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveCompraItem(item)">X</button>
                            </li>
                        }
                    }
                </ul>

                <div class="card-body">
                    <div class="d-flex justify-content-between fw-bold mb-3">
                        <span>Total:</span>
                        <span>@carritoState.Compra.PrecioTotal.ToString("0.00") €</span>
                    </div>

                    @if (!string.IsNullOrEmpty(errorCarrito))
                    {
                        <div class="alert alert-danger p-2 mb-3"><small>@errorCarrito</small></div>
                    }

                    <button class="btn btn-primary w-100 fw-bold" id="comprarLibrosButton" @onclick="ComprarLibros">Continuar a Comprar</button>
                </div>
            </div>
        </div>

    </div>
</div>

@code {
    private ICollection<LibroParaComprarDTO>? libros;

    // Variables para filtros
    private string? libroGenero;
    private double? precioMaximo;

    // Acceso al carrito
    private CompraForCreateDTO carrito => carritoState.Compra;

    private string messageError = "";
    private string? errorCarrito;

    private void AddLibro(LibroParaComprarDTO libro)
    {
        errorCarrito = null;
        carritoState.AddLibroToCompra(libro, 1);
    }

    private void RemoveCompraItem(CompraItemDTO item)
    {
        carritoState.RemoveCompraItemToCompra(item);
    }

    protected override async Task OnInitializedAsync()
    {
        await SearchLibros();
    }

    protected async Task SearchLibros()
    {
        string? filtroGenero = string.IsNullOrWhiteSpace(libroGenero) ? null : libroGenero.Trim();
        messageError = "";

        try
        {
            libros = await apiservice.GetLibrosParaComprarAsync(filtroGenero, precioMaximo, System.Threading.CancellationToken.None);
        }
        catch (ApiException ex)
        {
            libros = new List<LibroParaComprarDTO>();
            messageError = "Error al conectar con el servidor para obtener los libros.";
            logger.LogError(ex, "Error! There was an error while connecting to the GetLibrosParaComprarAsync service");
        }

        StateHasChanged();
    }

    private void ComprarLibros()
    {
        if (!carrito.CompraItems.Any())
        {
            errorCarrito = "Debes añadir al menos un libro antes de continuar.";
            return;
        }

        navigation.NavigateTo("/compras/createcompra");
    }
}